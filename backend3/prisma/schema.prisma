// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Quiz {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  questions   Question[]
  attempts    Attempt[]
}

model Question {
  id          Int      @id @default(autoincrement())
  quizId      Int
  question    String
  explanation String?
  concept     String?
  subject     String?
  ncert       Boolean  @default(false)
  ref         String?

  quiz        Quiz     @relation(fields: [quizId], references: [id])
  options     Option[]
  responses   Response[]

  @@index([quizId])
}

model Option {
  id          Int      @id @default(autoincrement())
  questionId  Int
  text        String
  isCorrect   Boolean  @default(false)

  question    Question @relation(fields: [questionId], references: [id])
  responses   Response[]

  @@index([questionId])
}

model Attempt {
  id             Int        @id @default(autoincrement())
  quizId         Int
  submissionHash String     @unique
  score          Int
  accuracy       Float
  totalQuestions Int
  createdAt      DateTime   @default(now())

  quiz           Quiz       @relation(fields: [quizId], references: [id])
  responses      Response[]

  @@index([quizId])
  @@index([createdAt])
}

model Response {
  id         Int      @id @default(autoincrement())
  attemptId  Int
  questionId Int
  optionId   Int
  createdAt  DateTime @default(now())

  attempt    Attempt  @relation(fields: [attemptId], references: [id])
  question   Question @relation(fields: [questionId], references: [id])
  option     Option   @relation(fields: [optionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@index([optionId])
}
